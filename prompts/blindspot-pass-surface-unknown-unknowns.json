{
    "template": "*Output only in {{lang}}.\n\n我正在進行 {{task}}，但我對 {{area}} 的經驗只有 {{experience}}。\n\n先不要實作。\n\n請對 {{code_path}} 執行一次 blindspot pass：\n\n1. 找出我可能完全沒想到的 unknown unknowns。\n2. 搜尋相關程式碼、歷史決策、測試與既有慣例。\n3. 說明每個盲區為何重要，以及忽略它會怎樣失敗。\n4. 為每個盲區提供一條應加入正式 prompt 的限制或問題。\n5. 最後整合成一份更完整的 implementation prompt。",
    "fieldValues": {
        "task": "[任務]",
        "area": "[模組／領域]",
        "experience": "[經驗程度]",
        "code_path": "[程式碼路徑]",
        "lang": "zh-tw"
    },
    "fields": [
        {
            "name": "task",
            "type": "textarea",
            "default": "[任務]"
        },
        {
            "name": "area",
            "type": "textarea",
            "default": "[模組／領域]"
        },
        {
            "name": "experience",
            "type": "textarea",
            "default": "[經驗程度]"
        },
        {
            "name": "code_path",
            "type": "textarea",
            "default": "[程式碼路徑]"
        },
        {
            "name": "lang",
            "type": "textarea",
            "default": "zh-tw"
        }
    ]
}
